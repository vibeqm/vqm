// markdownlint for this repository (VibeQM Level 2: verification on every change).
// The rules that fight hand-wrapped prose and generated tables are off; the rest
// (headings, lists, fences, links) stay on.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
